{
  "name": "pillmate",
  "private": true,
  "version": "0.1.0",
  "description": "Group-based medication care web app",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm --filter @pillmate/server dev",
    "dev:web": "pnpm --filter @pillmate/web dev",
    "build": "pnpm --filter @pillmate/server build",
    "build:web": "pnpm --filter @pillmate/web build",
    "build:all": "pnpm --filter @pillmate/server build && pnpm --filter @pillmate/web build",
    "db:init": "pnpm --filter @pillmate/server db:init"
  },
  "workspaces": [
    "apps/*"
  ]
}
