{
  "name": "@pillmate/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node --watch dist/index.js",
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:init": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json && node dist/db/migrate.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "web-push": "^3.6.7",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.2",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.7.2"
  }
}
